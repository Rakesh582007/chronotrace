# Copy this file to .env and fill in real values. Never commit .env.
LLM_PROVIDER=gemini
LLM_API_KEY=
HF_TOKEN=
DATABASE_URL=sqlite:///./chronotrace.db
LLM_MODEL=
# Tried in order when LLM_MODEL still answers 429/503 after its retries (comma-separated)
LLM_MODEL_FALLBACKS=gemini-3.5-flash,gemini-3.1-flash-lite

# Step 7: demo doctor login (the app refuses to start without these)
DEMO_DOCTOR_NAME=
DEMO_DOCTOR_USER=
DEMO_DOCTOR_PASSWORD=
# At least 32 random characters, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=
